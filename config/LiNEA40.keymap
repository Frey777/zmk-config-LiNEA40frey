#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 2

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&mkp_input_listener {
    input-processors = <&zip_temp_layer 4 10000>;
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8 9>;
        };

        TABs {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        shifttab {
            bindings = <&kp LS(TAB)>;
            key-positions = <0 1 2>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <10 0>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <21 20>;
        };

        doublquatation {
            bindings = <&kp SQT>;
            key-positions = <18 19>;
        };

        kakuninyou {
            bindings = <&none>;
            key-positions = <26 27 28 29 30>;
        };
    };

    macros {
        GUID: GUID {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp U &kp N &kp DOT &kp S &kp DOT &kp O &kp K &kp U &kp N &kp O &kp LEFT_BRACKET &kp P &kp W &kp C &kp DOT &kp C &kp O &kp M>;
            label = "GUID";
        };

        pcpass: pwcpass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp L &kp I &kp V &kp E &kp I &kp N &kp LS(J) &kp U &kp N &kp E &kp N2 &kp N4 &kp N1 &kp N9 &kp N8 &kp N7 &kp EXCL>;
            label = "PWCPASS";
        };

        macpass: macpass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp L &kp T &kp E &kp R &kp N &kp A &kp T &kp I &kp V &kp E>;
            label = "MACPASS";
        };

        onepassword: onepassword {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp L &kp I &kp V &kp E &kp I &kp N &kp LS(J) &kp A &kp P &kp A &kp N &kp N7 &kp EXCL>;
            label = "ONEPASSWORD";
        };

        toMac: toMacStudio {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 200>, <&to 1>;

            label = "TOMACSTUDIO";
        };

        toWin: toiPad13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 200>, <&to 0>;

            label = "TOIPAD13";
        };

        toiPad13: toiPad11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 200>, <&to 1>;

            label = "TOIPAD11";
        };

        toiPadmini: toiPhone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&macro_wait_time 200>, <&to 1>;

            label = "TOIPHONE";
        };

        JRAticketSmartsheet2: JTAticketSmartsheet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp LEFT_SHIFT &kp ENTER &kp TAB &kp TAB &kp ENTER>;
            label = "JTATICKETSMARTSHEET";
        };

        JRAticketSmartsheet1: JRAticketSmartsheet1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp LEFT_SHIFT &kp ENTER &kp TAB &kp ENTER>;
            label = "JRATICKETSMARTSHEET1";
        };

        toandroid: toandroid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&macro_wait_time 200>, <&to 2>;

            label = "TOANDROID";
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN_default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                           &kp T                                      &kp Y                 &kp U  &kp I                &kp O        &kp P
&kp A             &kp S         &kp D         &kp F                           &kp G                                      &kp H                 &kp J  &kp K                &kp L        &kp ENTER
&kp Z             &kp X         &kp C         &kp V                           &kp B                                      &kp N                 &kp M  &kp COMMA            &kp DOT      &kp MINUS
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_SHIFT INTERNATIONAL_5  &lt 6 SPACE  &lt 3 ENTER    &kp BACKSPACE  &mt RIGHT_SHIFT INT4         &lt 8 RIGHT_BRACKET  &lt 8 SLASH  &mt RIGHT_CONTROL LEFT_BRACKET
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MacDefault {
            bindings = <
&kp Q             &kp W             &kp E         &kp R                 &kp T                                      &kp Y                  &kp U  &kp I                &kp O        &kp P
&kp A             &kp S             &kp D         &kp F                 &kp G                                      &kp H                  &kp J  &kp K                &kp L        &kp ENTER
&kp Z             &kp X             &kp C         &kp V                 &kp B                                      &kp N                  &kp M  &kp COMMA            &kp DOT      &kp MINUS
&kp LEFT_COMMAND  &kp LEFT_CONTROL  &kp LEFT_ALT  &mt LEFT_SHIFT LANG2  &lt 9 SPACE  &lt 3 ENTER    &kp BACKSPACE  &mt RIGHT_SHIFT LANG1         &lt 8 RIGHT_BRACKET  &lt 8 SLASH  &mt LEFT_COMMAND AT_SIGN
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        AndDefault {
            bindings = <
&kp Q             &kp W             &kp E         &kp R                 &kp T                                      &kp Y                  &kp U  &kp I                &kp O        &kp P
&kp A             &kp S             &kp D         &kp F                 &kp G                                      &kp H                  &kp J  &kp K                &kp L        &kp ENTER
&kp Z             &kp X             &kp C         &kp V                 &kp B                                      &kp N                  &kp M  &kp COMMA            &kp DOT      &kp MINUS
&kp LEFT_COMMAND  &kp LEFT_CONTROL  &kp LEFT_ALT  &mt LEFT_SHIFT LANG2  &lt 9 SPACE  &lt 3 ENTER    &kp BACKSPACE  &mt RIGHT_SHIFT LANG1         &lt 8 RIGHT_BRACKET  &lt 8 SLASH  &mt LEFT_COMMAND AT_SIGN
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        Num {
            bindings = <
&kp EQUAL              &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp LS(APOS)                         &kp DOT    &kp ASTRK  &kp N7  &kp N8    &kp N9
&kp LEFT_PARENTHESIS   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS                            &kp FSLH   &kp MINUS  &kp N4  &kp N5    &kp N6
&kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(SEMI)                         &kp EQUAL  &kp PLUS   &kp N1  &kp N2    &kp N3
&trans                 &kp N0        &kp FSLH      &trans        &lt 7 SPACE   &trans    &lt 7 SPACE  &trans                &kp N0  &kp PLUS  &kp EQUAL
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mo 5   &mkp MB2  &mkp MB3
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans    &trans
            >;
        };

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &trans        &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        CURSOR {
            bindings = <
&kp LS(N1)          &kp LS(N2)          &kp LS(N3)           &kp LS(N4)           &kp LS(N5)                                        &kp LS(N6)             &kp LS(N7)     &kp LS(N8)      &kp LS(N9)       &kp LS(N0)
&trans              &kp LA(LEFT_ARROW)  &kp UP_ARROW         &kp LA(RIGHT_ARROW)  &GUID                                             &kp MINUS              &kp EQUAL      &kp LBKT        &kp RBKT         &kp BSLH
&kp LSHFT           &kp LEFT_ARROW      &kp DOWN_ARROW       &kp RIGHT_ARROW      &pcpass                                           &kp LS(MINUS)          &kp LS(EQUAL)  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LS(BSLH)
&kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)    &kp LG(RIGHT_ARROW)  &kp LG(DOWN_ARROW)   &trans      &lt 7 ENTER    &JRAticketSmartsheet1  &JRAticketSmartsheet2                 &kp DOT         &kp LG(LS(S))    &kp LS(INT1)
            >;
        };

        MARK {
            bindings = <
&kp F1                      &kp F2           &kp F3           &kp F4         &kp F5                           &kp F6        &kp F7        &kp F8                 &kp F9                &kp F10
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp SEMICOLON  &kp SEMICOLON                    &kp C_MUTE    &kp LS(LBKT)  &kp RIGHT_BRACKET      &kp BACKSLASH         &kp EQUAL
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp APOS       &kp SQT                          &kp KP_EQUAL  &kp INT3      &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)     &kp LS(INT1)
&trans                      &trans           &trans           &trans         &trans         &trans    &trans  &trans                      &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp LS(QUESTION)
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &toMac          &toWin  &toiPad13  &toandroid  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &to 1           &to 0   &trans     &trans      &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans  &trans     &trans      &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock          &trans     &trans      &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        MacArrow {
            bindings = <
&kp LS(N1)              &kp LS(N2)            &kp LS(N3)               &kp LS(N4)              &kp LS(N5)                                          &kp LS(N6)             &kp LS(N7)     &kp LS(N8)      &kp LS(N9)       &kp LS(N0)
&trans                  &kp LG(LEFT_ARROW)    &kp UP_ARROW             &kp LG(RIGHT_ARROW)     &macpass                                            &kp MINUS              &kp EQUAL      &kp LBKT        &kp RBKT         &kp BSLH
&kp LSHFT               &kp LEFT_ARROW        &kp DOWN_ARROW           &kp RIGHT_ARROW         &onepassword                                        &kp LS(MINUS)          &kp LS(EQUAL)  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LS(BSLH)
&kp LG(LA(LEFT_ARROW))  &kp LG(LA(UP_ARROW))  &kp LG(LA(RIGHT_ARROW))  &kp LG(LA(DOWN_ARROW))  &trans        &lt 7 ENTER    &JRAticketSmartsheet1  &JRAticketSmartsheet2                 &kp DOT         &kp LG(LS(N5))   &kp UNDERSCORE
            >;
        };
    };
};
